# Make の設定ファイル。値を引用符で囲まない。# は \#、$ は $$ と書く。
# このファイルを make init-env で env.sh にコピーし、各サーバーで編集する。
SERVER_ID=s1
APP_USER=isucon
BUILD_DIR=/home/isucon/webapp/go
BIN_NAME=isucondition
SERVICE_NAME=isucondition.go.service
DB_SERVICE=mysql
NGINX_SERVICE=nginx

DB_PATH=/etc/mysql
NGINX_PATH=/etc/nginx
NGINX_CONFIG=/etc/nginx/nginx.conf
# 対象の access_log が sites-enabled 等にある場合は、そのファイルを指定する。
NGINX_ACCESS_CONFIG=/etc/nginx/nginx.conf
SYSTEMD_PATH=/etc/systemd/system
APP_ENV=/home/isucon/env.sh
NGINX_LOG=/var/log/nginx/access.log
DB_SLOW_LOG=/var/log/mysql/mariadb-slow.log
MYSQL_OS_USER=mysql
MYSQL_OS_GROUP=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=isucon
MYSQL_PASS=
MYSQL_DBNAME=isucondition

# このリポジトリ内の Git 設定に使う。
GIT_USER_NAME=server
GIT_USER_EMAIL=github-actions[bot]@users.noreply.github.com

# 空なら外部へ通知しない。必要な場合だけ自分たちの送信先を設定する。
WEBHOOK_URL=
